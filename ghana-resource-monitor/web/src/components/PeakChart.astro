---
import { fmt, peaks, forecast, latest } from '../lib/energy';

// Geometry
const W = 720, H = 300, L = 50, R = 690, T = 20, B = 260;
const y0 = peaks[0].year, y1 = forecast[forecast.length - 1].year;
const maxV = Math.ceil(Math.max(...forecast.map((f) => f.p90)) / 1000) * 1000;
const minV = Math.floor(Math.min(...peaks.map((p) => p.value)) / 1000) * 1000;
const x = (yr: number) => L + ((yr - y0) / (y1 - y0)) * (R - L);
const y = (v: number) => B - ((v - minV) / (maxV - minV)) * (B - T);
const ticks: number[] = []; for (let v = minV; v <= maxV; v += 1000) ticks.push(v);
const xt: number[] = []; for (let yr = y0; yr <= y1; yr += 2) xt.push(yr);
const hist = peaks.map((p) => `${x(p.year).toFixed(1)},${y(p.value).toFixed(1)}`).join(' ');
const mid = [{ year: latest.year, p50: latest.value, p10: latest.value, p90: latest.value }, ...forecast];
const proj = mid.map((f) => `${x(f.year).toFixed(1)},${y(f.p50).toFixed(1)}`).join(' ');
const band = [...mid.map((f) => `${x(f.year).toFixed(1)},${y(f.p90).toFixed(1)}`),
              ...[...mid].reverse().map((f) => `${x(f.year).toFixed(1)},${y(f.p10).toFixed(1)}`)].join(' ');
const last = forecast[forecast.length - 1];
const label = `Line chart of annual peak demand in megawatts. Actual: ${fmt(peaks[0].value)} MW in ${y0} rising to ${fmt(latest.value)} MW in ${latest.year}. Baseline projection: about ${fmt(last.p50)} MW by ${last.year}, with an 80 percent range of ${fmt(last.p10)} to ${fmt(last.p90)} MW.`;
---
<svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={label} style="width:100%;height:auto;display:block">
  {ticks.map((v) => (<>
    <line x1={L} x2={R} y1={y(v)} y2={y(v)} stroke="#d9d4c6" />
    <text x={L - 8} y={y(v) + 4} text-anchor="end" font-size="11" fill="#5d6358">{fmt(v)}</text>
  </>))}
  <text x={L - 8} y="12" text-anchor="end" font-size="11" fill="#5d6358">MW</text>
  <line x1={x(latest.year)} x2={x(latest.year)} y1={T} y2={B} stroke="#bdb8a8" stroke-dasharray="3 3" />
  <text x={x(latest.year) - 6} y="30" text-anchor="end" font-size="11" fill="#5d6358">Actual</text>
  <text x={x(latest.year) + 6} y="30" font-size="11" fill="#5d6358">Projected</text>
  <polygon points={band} fill="#2f8f5b" fill-opacity=".14" />
  <polyline points={proj} fill="none" stroke="#2f8f5b" stroke-width="2.5" stroke-dasharray="6 4" />
  <polyline points={hist} fill="none" stroke="#2f8f5b" stroke-width="2.5" />
  {peaks.map((p, i) => (<circle cx={x(p.year)} cy={y(p.value)} r={i === peaks.length - 1 ? 5 : 4} fill="#2f8f5b" stroke="#fff" stroke-width="2" />))}
  {xt.map((yr) => (<text x={x(yr)} y="282" text-anchor="middle" font-size="11" fill="#5d6358">{yr}</text>))}
</svg>
