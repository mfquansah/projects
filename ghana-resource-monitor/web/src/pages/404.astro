---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" active="none" description="That page does not exist.">
  <section style="display:flex;flex-direction:column;gap:12px;max-width:60ch">
    <span class="eyebrow">404</span>
    <h1 style="margin:0;font-size:38px;line-height:1.1">We could not find that page.</h1>
    <p class="muted" style="margin:0">Try the <a href="/">Energy page</a>, the <a href="/scenarios/">scenario tool</a>, or <a href="/data/">Data and methods</a>.</p>
  </section>
</Base>
